# Vivado 2019.x / 2026.x project build output.
# Tracked per project: *.xpr, *.srcs/ (VHDL, testbenches, .xci), *.xdc, *.wcfg, final bitstream.

# Regenerated by Vivado on open/build
*.cache/
*.hw/
*.ip_user_files/
*.sim/
*.gen/
.Xil/
NA/

# Run output: ignore everything except the bitstream (lets the board be programmed without rebuilding)
**/*.runs/**
!**/*.runs/**/
!**/*.runs/impl_*/*.bit

# Logs, journals, crash dumps
*.jou
*.log
*.str
*.backup.*
hs_err_pid*
vivado_pid*
webtalk*
usage_statistics_webtalk.*

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*~
.zip
